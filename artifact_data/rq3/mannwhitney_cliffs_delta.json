{
  "date": "2026-10-13",
  "analysis": "RQ3 Mann-Whitney U test plus Cliffs delta; replaces prior index-paired signed-rank analysis",
  "scope": "Four query-diversity metrics, HistDB versus six baselines; 24 comparisons",
  "analysis_unit": "one 1000-query sample; 30 disjoint samples per tool from frozen query corpora; not independent generator runs",
  "pairing": "none; no sample-index pairing and no sorting to create pairs",
  "software": {
    "scipy": "1.13.1",
    "numpy": "1.26.4",
    "statsmodels": "0.14.2"
  },
  "test_options": {
    "alternative": "two-sided",
    "method": "asymptotic",
    "use_continuity": true,
    "tie_correction": true,
    "multiplicity": "Holm adjustment over all 24 comparisons, additional to raw p"
  },
  "effect_size_definition": {
    "name": "Cliffs delta",
    "formula": "(count(x_i > y_j) - count(x_i < y_j)) / (n_x*n_y)",
    "x": "HistDB sample values",
    "y": "baseline sample values",
    "n_x": 30,
    "n_y": 30,
    "denominator": 900,
    "ties": "contribute zero to numerator",
    "positive": "HistDB tends to have higher values",
    "negative": "baseline tends to have higher values",
    "relation_to_U": "delta = 2*U_HistDB/(n_x*n_y)-1"
  },
