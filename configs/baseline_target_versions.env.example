# Fixed DBMS versions for server-side baseline experiments.
# Copy or source this file before launching long-running runs.

# Coverage target for Neo4j baselines.
NEO4J_VERSION=2026.03.1
NEO4J_IMAGE=neo4j:2026.03.1
NEO4J_SOURCE_ROOT=/data/experiments/source_builds/neo4j-2026.03.1
NEO4J_ZIP=/data/experiments/source_builds/neo4j-2026.03.1/packaging/standalone/target/neo4j-community-2026.03.1-unix.tar.gz

# Coverage target for Memgraph baselines.
# The local machine currently has memgraph/memgraph:3.9.0, so "3.9" is pinned
# to the explicit Docker tag 3.9.0.
MEMGRAPH_VERSION=3.9.0
MEMGRAPH_IMAGE=memgraph/memgraph:3.9.0
MEMGRAPH_SOURCE_ROOT=/data/experiments/source_builds/memgraph-3.9.0-src
MEMGRAPH_BUILD_ROOT=/data/experiments/source_builds/memgraph-3.9.0-coverage-build

# Non-coverage bug-finding/generalization targets.
FALKORDB_VERSION=4.16.8
FALKORDB_IMAGE=falkordb/falkordb:v4.16.8

# Use the Apache AGE image already present on the local machine.
AGE_VERSION=local-apache-age-latest
AGE_IMAGE=apache/age:latest

# Requested ArcadeDB version. If this exact Docker tag is unavailable on the
# server, the local machine has arcadedata/arcadedb:26.4.1-SNAPSHOT as the
# closest already-present image.
ARCADEDB_VERSION=26.4.1
ARCADEDB_IMAGE=arcadedata/arcadedb:26.4.1
ARCADEDB_LOCAL_FALLBACK_IMAGE=arcadedata/arcadedb:26.4.1-SNAPSHOT
