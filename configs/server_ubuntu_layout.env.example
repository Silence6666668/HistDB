# Ubuntu experiment server layout.
# Copy this file to configs/server_ubuntu_layout.env on the server and edit it.

# Put the repository on a local NVMe-backed path when possible.
PROJECT_ROOT=/data/repos/graph-bug-fuzz-mvp

# Keep large experiment artifacts outside the git repository.
EXPERIMENT_ROOT=/data/experiments
COVERAGE_RUNS_ROOT=/data/experiments/coverage_runs
BASELINE_RUNS_ROOT=/data/experiments/baseline_runs
DB_DATA_ROOT=/data/experiments/dbdata
SOURCE_BUILDS_ROOT=/data/experiments/source_builds
ARCHIVE_ROOT=/data/experiments/archives
TMP_ROOT=/data/experiments/tmp

# Optional Docker data-root. Only apply before Docker has important state.
DOCKER_DATA_ROOT=/data/docker

# Fixed DBMS versions for baseline experiments.
NEO4J_VERSION=2026.03.1
NEO4J_IMAGE=neo4j:2026.03.1
MEMGRAPH_VERSION=3.9.0
MEMGRAPH_IMAGE=memgraph/memgraph:3.9.0
FALKORDB_VERSION=4.16.8
FALKORDB_IMAGE=falkordb/falkordb:v4.16.8
AGE_VERSION=local-apache-age-latest
AGE_IMAGE=apache/age:latest
ARCADEDB_VERSION=26.4.1
ARCADEDB_IMAGE=arcadedata/arcadedb:26.4.1
ARCADEDB_LOCAL_FALLBACK_IMAGE=arcadedata/arcadedb:26.4.1-SNAPSHOT

# Baseline artifact roots used by symlinks inside the repo.
GDSMITH_BASELINE_ROOT=/data/experiments/baseline_runs/GDsmith
GDBMETER_BASELINE_ROOT=/data/experiments/baseline_runs/gdbmeter
DINKEL_BASELINE_ROOT=/data/experiments/baseline_runs/dinkel

# Per-DB data directories for manually started containers.
NEO4J_DATA_ROOT=/data/experiments/dbdata/neo4j
MEMGRAPH_DATA_ROOT=/data/experiments/dbdata/memgraph
FALKORDB_DATA_ROOT=/data/experiments/dbdata/falkordb
AGE_DATA_ROOT=/data/experiments/dbdata/apache-age
ARCADEDB_DATA_ROOT=/data/experiments/dbdata/arcadedb

# Neo4j source checkout used for source-level JaCoCo reports.
NEO4J_SOURCE_ROOT=/data/experiments/source_builds/neo4j-2026.03.1
NEO4J_ZIP=/data/experiments/source_builds/neo4j-2026.03.1/packaging/standalone/target/neo4j-community-2026.03.1-unix.tar.gz

# Memgraph source-coverage build and output locations.
# Use a fixed Memgraph checkout/commit for all Memgraph coverage experiments.
MEMGRAPH_SOURCE_ROOT=/data/experiments/source_builds/memgraph-3.9.0-src
MEMGRAPH_BUILD_ROOT=/data/experiments/source_builds/memgraph-3.9.0-coverage-build
MEMGRAPH_COVERAGE_ROOT=/data/experiments/coverage_runs/memgraph
MEMGRAPH_LCOV_ROOT=/data/experiments/coverage_runs/memgraph/lcov

# Default ports for isolated long-running experiments.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_COVERAGE_PORT=36340
MEMGRAPH_BOLT_PORT=7787
FALKORDB_PORT=6379
AGE_PORT=5455
ARCADEDB_HTTP_PORT=2480

# Java memory defaults for Neo4j coverage runs. Tune for the server size.
NEO4J_HEAP_INITIAL=2g
NEO4J_HEAP_MAX=8g
NEO4J_PAGECACHE=4g

# C/C++ source coverage defaults for Memgraph coverage runs.
MEMGRAPH_COVERAGE_TOOL=lcov
MEMGRAPH_COVERAGE_EPOCH_SECONDS=300
MEMGRAPH_COVERAGE_CFLAGS="--coverage -O0 -g"
MEMGRAPH_COVERAGE_CXXFLAGS="--coverage -O0 -g"
MEMGRAPH_COVERAGE_LDFLAGS="--coverage"

# Long-run defaults.
EXPERIMENT_BUDGET_SECONDS=86400
SNAPSHOT_INTERVAL_SECONDS=300
